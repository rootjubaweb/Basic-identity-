rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEnrollment(data) {
      return data.userId == request.auth.uid &&
             data.projectId is string && data.projectId.size() <= 60 &&
             data.enrollmentToken is string && data.enrollmentToken.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('enterpriseName' in data) || (data.enterpriseName is string && data.enterpriseName.size() <= 120)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                       isValidId(enrollmentId) && 
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'projectId', 'enrollmentToken', 'createdAt']) &&
                       isValidEnrollment(incoming());

      allow update: if isSignedIn() && 
                       isValidId(enrollmentId) && 
                       existing().userId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       isValidEnrollment(incoming());

      allow delete: if isSignedIn() && 
                       isValidId(enrollmentId) && 
                       existing().userId == request.auth.uid;
    }
  }
}
